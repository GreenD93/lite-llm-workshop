# 실습 정책값 SSOT. `cp .env.example .env` 후 필요하면 수정한다.
# 서버(docker compose)·운영자 스크립트(admin/)·클라이언트 스크립트(client/) 모두 이 파일을 읽는다.

# ── 이미지 (검증 버전: LiteLLM 1.104.0, Keycloak 26.4) ──
LITELLM_IMAGE=ghcr.io/berriai/litellm:main-stable
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.4

# ── 외부 노출 URL (워크샵의 CloudFront 도메인 2개 역할) ──
GATEWAY_PORT=4000                          # nginx: /auth/* → broker, 나머지 → LiteLLM
KEYCLOAK_PORT=8080
GATEWAY_URL=http://localhost:4000
KEYCLOAK_URL=http://localhost:8080

# ── 비밀값 (실습용. 프로덕션은 Secrets Manager) ──
POSTGRES_PASSWORD=workshop-db-pw
LITELLM_MASTER_KEY=sk-workshop-master       # 반드시 sk- 로 시작. broker와 운영자만 안다.
LITELLM_SALT_KEY=sk-workshop-salt           # DB 저장 자격증명 암호화 키. 한 번 정하면 바꾸지 않는다.
KEYCLOAK_ADMIN_PASSWORD=admin

# ── 키 발급 정책 (broker) ──
KEY_DURATION=4h                            # 임시 Virtual Key 수명. 데모에서 만료를 보려면 5m 등으로 줄인다.

# ── 모델 백엔드 ──
OLLAMA_API_BASE=http://host.docker.internal:11434   # 호스트에서 돌고 있는 Ollama

# ── 사용자 온보딩 기본 정책 (admin/onboard-users.sh, 모듈 2-3) ──
USER_MAX_BUDGET=5          # USD. 사용자별 지출 한도. 초과 시 게이트웨이가 요청을 거절한다.
USER_BUDGET_DURATION=30d   # 예산 초기화 주기
USER_RPM_LIMIT=30          # 사용자별 분당 요청 수
